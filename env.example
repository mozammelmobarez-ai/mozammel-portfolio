PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_in_production
JWT_EXPIRE=7d
ADMIN_USERNAME=root
ADMIN_PASSWORD_HASH=

# Leave empty to use local SQLite at db/portfolio.db
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=

# false = do not insert default categories on startup
SEED_DEFAULT_CATEGORIES=false
